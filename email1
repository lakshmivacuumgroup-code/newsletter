""" + FLUID + "</style>\n"
COLOUR_MAP = [
    (r'color:\s*#14448F', 'color:#000000'), (r'color:\s*#0A2E66', 'color:#000000'),
    (r'color:\s*#01A0E2', 'color:#FFFFFF'), (r'color:\s*#4FC3F7', 'color:#FFFFFF'),
    (r'color:\s*#8FD3F5', 'color:#FFFFFF'), (r'color:\s*#C8161D', 'color:#000000'),
