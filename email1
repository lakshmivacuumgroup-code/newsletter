    (r'color:\s*#4A586B', 'color:#4A4A4A'), (r'color:\s*#5B6B80', 'color:#555555'),
    (r'color:\s*#D6E2F2', 'color:#E6E6E6'), (r'color:\s*#C8D8F0', 'color:#D0D0D0'),
    (r'background:\s*#14448F', 'background:#000000'), (r'bgcolor="#14448F"', 'bgcolor="#000000"'),
    (r'background:\s*#0A1F45', 'background:#000000'), (r'bgcolor="#0A1F45"', 'bgcolor="#000000"'),
    (r'background:\s*#01A0E2', 'background:#000000'), (r'bgcolor="#01A0E2"', 'bgcolor="#000000"'),
    (r'background:\s*#EAF0F6', 'background:#FFFFFF'), (r'bgcolor="#EAF0F6"', 'bgcolor="#FFFFFF"'),
    (r'#E21D24', '#000000'),
]
def responsive(html, bg="#EAF0F6"):
    out = html.replace('<meta charset="utf-8">',
                       '<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">', 1)
    out = re.sub(r'<div style="width:\s*640px;\s*min-height:\s*\d+px;\s*background:\s*#EAF0F6">',
                 '<div style="width:100%%;background:%s">' % bg, out, count=1)
    out = out.replace("</helmet>", (RESP_CSS if bg == "#EAF0F6" else FONTFACE) + "</helmet>", 1)
    return out
def industrial(html):
    out = responsive(html, bg="#FFFFFF")
    out = re.sub(r'<link href="https://fonts\.googleapis\.com/css2[^"]*" rel="stylesheet">\s*', '', out, count=1)
    out = re.sub(r"font-family:'Archivo'[^;\"']*('[^']*')?", "font-family:'LV Playfair',Georgia,serif", out)
    out = re.sub(r"font-family:'IBM Plex Sans',Arial,Helvetica,sans-serif", "font-family:'LV Inter',Inter,Arial,sans-serif", out)
    out = re.sub(r'background-image:\s*linear-gradient\([^)]*\)', 'background-image:none', out)
    for pat, rep in COLOUR_MAP:
        out = re.sub(pat, rep, out)
    heads = []
    def head_tag(m):
        tag = m.group(0)
        sm = re.search(r'style="([^"]*)"', tag)
        if not sm or "h2-ind" in tag:
            return tag
        style = sm.group(1)
        size = re.search(r"font-size:(\d+)px", style)
        weight = re.search(r"font-weight:(\d+)", style)
        dark = "color:#000000" in style
        text = re.sub(r"<[^>]+>", "", tag.split(">", 1)[1]) if ">" in tag else ""
        if (size and int(size.group(1)) >= 20 and weight and int(weight.group(1)) >= 800 and dark
                and len(text.strip()) >= 12):
            heads.append(text.strip()[:44])
            if 'class="' in tag:
                return re.sub(r'class="([^"]*)"', lambda c: 'class="%s h2-ind"' % c.group(1), tag, count=1)
            return re.sub(r'style="', 'class="h2-ind" style="', tag, count=1)
        return tag
    out = re.sub(r'<(?:div|td|span)\b[^>]*>[^<]*', head_tag, out)
    print("   industrial: H2-treated headings (%d): %s" % (len(heads), " | ".join(heads)))
    return out
resp, ind = responsive(t), industrial(t)
for name, html in (("Email-responsive.html", resp), ("Email-industrial.html", ind)):
